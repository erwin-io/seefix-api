# SEEFIX Node / Express API
NODE_ENV=development
PORT=3000
API_HOST=127.0.0.1

# PostgreSQL - must point to the same canonical SEEFIX database used by seefix-agents.
DATABASE_URL=postgresql://postgres:admin123@127.0.0.1:5432/seefixdb
DATABASE_SSLMODE=prefer
DATABASE_SSLROOTCERT=
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_POOL_MAX=10

# JWT
JWT_SECRET=PWUdScknn7Bx15mAB1golRjYtrQszbnmu7d6Oexjpxzkj_MzXPVy070Ac7eqmSNw
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# SEEFIX FastAPI Agent
LOCAL_AGENT_URL=http://127.0.0.1:8000
LOCAL_AGENT_SECRET=PWUdScknn7Bx15mAB1golRjYtrQszbnmu7d6Oexjpxzkj_MzXPVy070Ac7eqmSNw
AGENT_TIMEOUT_MS=30000
AGENT_HEALTH_TIMEOUT_MS=10000
AGENT_DEBUG_ERRORS=false

# Cloudinary - report and work-order evidence images.
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
CLOUDINARY_REPORT_FOLDER=seefix/reports
CLOUDINARY_WORK_ORDER_FOLDER=seefix/work-orders
CLOUDINARY_DOCUMENT_FOLDER=seefix/procurement
MAX_UPLOAD_MB=10
MAX_REPORT_IMAGES=5

# CORS - comma separated. Leave blank for local/native mobile clients that do not use browser CORS.
CORS_ORIGINS=

# Procurement handoff defaults. These create metadata/outbox records; SEEFIX does not implement bidding/provider selection.
PROCUREMENT_TO_EMAILS=
PROCUREMENT_CC_EMAILS=
PROCUREMENT_FOLLOWUP_HOURS=24
