# auto: local on a developer machine, huggingface when deployed on Vercel
AGENT_PROVIDER=auto

# Local FastAPI/Ollama agent
LOCAL_AGENT_URL=http://127.0.0.1:8000

# Hosted Gradio agent
HF_SPACE_ID=erwinramirez220/seefix-agents

# Keep this below Vercel's function maximum duration.
AGENT_TIMEOUT_MS=240000

# Vercel request bodies are limited to 4.5 MB, including multipart overhead.
MAX_UPLOAD_MB=4

PORT=3000
